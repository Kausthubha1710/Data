elif response.status_code == 401:
    logging.warning(
        "Dynatrace API returned 401. Refreshing token. URL: %s",
        url
    )

    self.tokens.get(environment, {}).pop(region, None)

    headers = {
        'Accept': 'application/json',
        'Authorization': 'Bearer ' + self._get_api_token(
            environment=environment,
            region=region
        )
    }

    return self._get_request_result(
        url=url,
        headers=headers,
        keypair=keypair,
        parser=parser,
        environment=environment,
        region=region
    )

else:
    logging.error(
        "Dynatrace API FAILED"
    )
    logging.error(
        "Status code: %s",
        response.status_code
    )
    logging.error(
        "URL: %s",
        url
    )
    logging.error(
        "Response: %s",
        response.text[:2000]
    )

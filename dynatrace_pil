def robust_comment_search(row):
    for col in row.index:
        col_str = str(col)
        if "recentComments" in col_str or "comments" in col_str:
            val = row[col]
            if pd.isna(val) or val is None:
                continue
            
            # 1. Flattened list from pd.json_normalize
            if isinstance(val, list) and len(val) > 0:
                first_item = val[0]
                if isinstance(first_item, dict):
                    return first_item.get('content')
                return str(first_item)

            # 2. Nested dictionary
            elif isinstance(val, dict):
                comments_list = val.get('comments', [])
                if isinstance(comments_list, list) and len(comments_list) > 0:
                    return comments_list[0].get('content')

            # 3. Raw JSON string
            elif isinstance(val, str) and val.startswith('{'):
                try:
                    data = json.loads(val)
                    if isinstance(data, dict):
                        comments_list = data.get('comments', [])
                        if isinstance(comments_list, list) and len(comments_list) > 0:
                            return comments_list[0].get('content')
                except Exception:
                    pass
    return None



        return {"score": score, "violations": None, "match": None, "rule": rule}


def check_all_questions_answered(text, questions):
    if not isinstance(text, str):
        return False, questions

    def strip_punctuation(s):
        s = re.sub(r"<[^>]*>", "", s)
        s = re.sub(r"[^\w\s]", "", s.lower())
        return s.strip()

    text_normalized = strip_punctuation(text)
    questions_normalized = [strip_punctuation(q) for q in questions]

    missing_questions = [
        q for q, q_norm in zip(questions, questions_normalized)
        if q_norm not in text_normalized
    ]

    text_without_questions = text_normalized
    for q_norm in questions_normalized:
        text_without_questions = text_without_questions.replace(q_norm, "")

    alnum_count = len(re.findall(r"\w", text_without_questions))
    is_valid = (len(missing_questions) == 0) and (alnum_count >= 2)
    return is_valid, missing_questions



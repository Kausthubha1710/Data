def has_keyword_with_details(text, keywords):
    return any(re.search(rf"\b{kw}\b", text) and len(re.findall(r"\w", re.sub(rf"\b{kw}\b", "", text))) >= 2 for kw in keywords)


def score_required_answers(primary_field_name, primary_field, required_keywords, score_per_field=1, fallback_field_name=None, fallback_field=None):
    primary_field_text = primary_field or ""
    fallback_field_text = (fallback_field or "") if fallback_field else ""
    total_score = 0
    messages = []
    for keyword in required_keywords:
        pattern = rf"(?i){re.escape(keyword)}\s*(.*)"
        match = re.search(pattern, primary_field_text, re.IGNORECASE | re.DOTALL)
        if match:
            answer = match.group(1).strip()
            if len(re.findall(r"\w", answer)) >= 2:
                total_score += score_per_field
            else:
                messages.append(f"{primary_field_name} is missing data for keyword '{keyword}'")
        else:
            if fallback_field:
                match_fb = re.search(pattern, fallback_field_text, re.IGNORECASE | re.DOTALL)
                if match_fb:
                    answer = match_fb.group(1).strip()
                    if len(re.findall(r"\w", answer)) >= 2:
                        total_score += score_per_field
                    else:
                        messages.append(f"{fallback_field_name} is missing data for keyword '{keyword}'")
                else:
                    messages.append(f"Both {primary_field_name} and {fallback_field_name} missing keyword '{keyword}'")
            else:
                messages.append(f"{primary_field_name} is missing keyword '{keyword}'")
    return total_score, messages



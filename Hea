def get_sla_max_duration_seconds_by_priority(priority: str):
    p_score = int(priority[0])

    # SLA duration in seconds for 1 - Critical : 2 hours 24/7 : https://bnpp.service-now.com/contract_sla.do?sys_id=02ad3fe9db055c1003ee4dc2ba9619df
    if p_score == 1:
        return 2 * 3600

    # SLA duration in seconds for 2 - High : 4 hours 24/7 : https://bnpp.service-now.com/contract_sla.do?sys_id=49df3f2ddb055c1003ee4dc2ba961915
    if p_score == 2:
        return 4 * 3600

    # SLA duration in seconds for 3 - Moderate : 8 working hours 8-18 : https://bnpp.service-now.com/contract_sla.do?sys_id=8800c83ddb055c1003ee4dc2ba961929
    if p_score == 3:
        return 1 * 10 * 3600

    # SLA duration in seconds for 4 - Low : 3 working days 8-18 : https://bnpp.service-now.com/contract_sla.do?sys_id=b810807ddb055c1003ee4dc2ba9619fd
    if p_score == 4:
        return 3 * 10 * 3600

    # SLA duration in seconds for 5 - Very Low : 7 working days 8-18 : https://bnpp.service-now.com/contract_sla.do?sys_id=3Dc020cc3ddb055c1003ee4dc2ba9619f9
    if p_score == 5:
        return 7 * 10 * 3600


def calculate_sla_usage(priority: str, sla_duration: int):
    return round(sla_duration / get_sla_max_duration_seconds_by_priority(priority=priority), 2) * 100


def calculate_business_duration(priority: str, start: datetime, end: datetime = datetime.now(timezone.utc)):
    p_score = int(priority[0])

    duration = (end - start).total_seconds()
    # return duration for 24/7 SLA support
    if p_score < 3:
        return duration

    # Convert to hours
    diff_hours = duration / 3600

    # Define working hours and days of week
    bday_start_time = time(8, 0)
    bday_end_time = time(18, 0)
    bday_work_days = [0, 1, 2, 3, 4]

    # calculate the difference
    work_hours = 0
    start_hour, start_minute, _ = start.time().hour, start.time().minute, start.time().second
    start_copy = start
    while start_copy <= end:
        if start_copy.weekday() in bday_work_days and bday_start_time <= start_copy.time() < bday_end_time:
            work_hours += (bday_end_time - start_copy.time()).seconds / 3600 + (bday_end_time - start_copy.time()).days * 8
            break

        start_copy += timedelta(hours=1)
        start_hour, start_minute, _ = start_copy.time().hour, start_copy.time().minute, start_copy.time().second

    return (diff_hours - (diff_hours - work_hours)) * 3600


def evaluate_text_field(
    content: str,
    text_length: int = 5,
    violation_comment: str = "Invalid field",
    scoring_value: int = 1,
    regex_match: str = ".*",
    word_counter: int = 1,
    diff_from: str = None,
    contains_list: list[str] = None,
    descriptive_keywords=None,
    sen_counter: int = 1,
    rule: str = None,
):
    score = scoring_value
    match = None

    if content is None or content == "" or not (isinstance(content, str)):
        score += -(scoring_value)
        violation_comment = violation_comment + " - This field cannot be empty"
    else:
        if len(content) < text_length:
            score += -1
            violation_comment = violation_comment + " - Not matching the minimum length"
        match = re.search(regex_match, content)
        if match is None:
            score += -1
            violation_comment = violation_comment + " - Not matching pattern validation"

        if diff_from is not None and content.upper() == diff_from.upper():
            score += -1
            violation_comment = violation_comment + " - Is matching exclusion value"

        if contains_list is not None:
            for contains in contains_list:
                if contains is not None and contains.upper() not in content.upper():
                    score += -1
                    violation_comment = violation_comment + " - Missing data: " + contains

        # Analyze textual complexity using tokenization
        if word_counter > 1:
            # Tokenize the content
            tokens = word_tokenize(content.strip())
            token_count = len(tokens)
            unique_tokens = set(tokens)
            unique_token_count = len(unique_tokens)

            if token_count < word_counter:
                score += -1
                violation_comment = violation_comment + " - Not matching the minimum token count"

            redundancy_ratio = unique_token_count / token_count if token_count > 0 else 0
            if redundancy_ratio < 0.5:
                score += -1
                violation_comment = violation_comment + " - Text is too redundant"

            if unique_token_count < word_counter:
                score += -1
                violation_comment = violation_comment + " - Unique token count is not matching the minimum token count"

            if descriptive_keywords:
                if not any(token in descriptive_keywords for token in unique_tokens):
                    score += -1
                    violation_comment = violation_comment + " - Missing some mandatory keywords"

        if sen_counter > 1:
            sen_token = sent_tokenize(content.strip())
            sen_token_count = len(sen_token)
            sen_unique_tokens = set(sen_token)
            sen_unique_token_count = len(sen_unique_tokens)

            redundancy_ratio = sen_unique_token_count / sen_token_count if sen_token_count > 0 else 0
            if redundancy_ratio < 0.5:
                score += -1
                violation_comment = violation_comment + " - Text is too redundant"

            if sen_unique_token_count < sen_counter:
                score += -1
                violation_comment = violation_comment + " - Minium sentence token count is not matching the minimum requirements"

    if score == scoring_value:
        return {"score": scoring_value, "violations": None, "match": match, "rule": rule}
    else:
        return {"score": max(0, score), "violations": violation_comment, "match": match, "rule": rule}


def evaluate_date_field(
    content: datetime,
    violation_comment: str = "Invalid field",
    scoring_value: int = 1,
    rule: str = None,
):

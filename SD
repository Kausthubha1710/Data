-- Keep everything above unchanged (SET SESSION ... and INSERT INTO sn_changes_ccb ... ON CONFLICT ...;)
-- Replace from "DO $$" to "END $$;" with the block below.
-- Rules per sign-off:
--   NOT_APPLICABLE or FAILURE                                    -> original behaviour: payload score + override 'yes'
--   SUCCESS + a file of that type containing the change number  -> payload score + override 'yes'
--   SUCCESS without such a file                                 -> nothing written

DO $$
BEGIN

-- UAT
IF '${payload.uat_signoff}' IN ('NOT_APPLICABLE', 'FAILURE')
   OR ('${payload.uat_signoff}' = 'SUCCESS' AND EXISTS (
     SELECT 1 FROM sn_attachments a
     WHERE a.table_name = 'change request'
       AND a.table_sys_id = '${payload.sys_id}'
       AND a.file_name ILIKE '%${payload.number}%'
       AND a.file_name ~* 'uso|uat|user\s*[-_ ]?\s*sign\s*[-_ ]?\s*off'
   )) THEN
  UPDATE sn_changes_rules_score
  SET score = ${payload.uat_signoff_score}, violation = ''
  WHERE sys_id = '${payload.sys_id}' AND rule_id = ${payload.uat_signoff_rule_id};

  INSERT INTO sn_changes_rules_score_override (sys_id, number, rule_id, override, updated_at, updated_by)
  VALUES ('${payload.sys_id}', '${payload.number}', '${payload.uat_signoff_rule_id}', 'yes', now(), '${payload.CurrentUserId}')
  ON CONFLICT (sys_id, rule_id) DO UPDATE
  SET number = '${payload.number}', override = 'yes', updated_at = now(), updated_by = '${payload.CurrentUserId}';
END IF;


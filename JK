"""
Replacements for `_get_request_result` and the `recentComments` handling in
`synchronize_problems`, addressing the two open review threads:

  1. "_get_request_result uses recursion... can cause stack overflow and
      O(n^2) memory copies" / "response.json() is called multiple times" /
      "concatenating all page DataFrames at once may consume a lot of
      memory... process each page incrementally"
  2. "Using pandas apply with a Python function processes each row
      sequentially... consider... processing outside of pandas and
      assigning the result as a column in bulk"
"""

import logging
import pandas as pd


# ----------------------------------------------------------------------
# 1. Pagination: iterative generator + thin DataFrame wrapper
# ----------------------------------------------------------------------
#
# `_iter_request_pages` does the actual work as a `while` loop:
#   - no recursion -> no stack-depth risk on deep pagination, and no
#     repeated pd.concat at every recursion level (that was the O(n^2)
#     copying the reviewer flagged)
#   - `response.json()` is parsed exactly once per page and reused for
#     both the payload and the nextPageKey check
#   - a 401 re-authenticates and `continue`s the same loop iteration
#     instead of recursing
#   - it *yields* each page immediately, so a caller that wants to stream
#     pages straight into Postgres/OpenSearch (rather than building one
#     big DataFrame first) can do so directly - this is what resolves the
#     "process incrementally instead of storing every page in a list"
#     comment for any future large/unbounded pull.
#
# `_get_request_result` keeps the exact same signature and return type as
# before (a single concatenated DataFrame), so every existing call site
# (management zones, servers, problems, metrics) needs no changes.

def _iter_request_pages(self, url, headers, keypair, parser="values",
                         environment="prd", region="emea", fields=None):
    page_url = url

    while True:
        try:
            response = self.http_requests.request(
                "GET", page_url, headers=headers, verify=self.config.get_ca_cert(),
                cert=keypair, timeout=300)
        except Exception as error:
            logging.warning(page_url)
            logging.debug(error)
            return

        if response.status_code == 401:
            self.tokens.get(environment, {}).pop(region, None)
            headers = {
                'Accept': 'application/json',
                'Authorization': 'Bearer ' + self._get_api_token(environment=environment, region=region)
            }
            continue  # retry the same page_url with a fresh token

        if response.status_code != 200:
            logging.warning(page_url)
            logging.debug(f'Error: {response.status_code}')
            return

        data = response.json()  # parsed once, reused below
        payload = data[parser] if parser is not None else data
        yield pd.json_normalize(payload, max_level=0)

        next_page_key = data.get("nextPageKey")
        if not next_page_key:
            return

        page_url = url.split("?")[0] + "?nextPageKey=" + next_page_key
        if fields:
            page_url += f"&fields={fields}"


def _get_request_result(self, url, headers, keypair, parser="values",
                         environment="prd", region="emea", fields=None):
    pages = list(self._iter_request_pages(
        url=url, headers=headers, keypair=keypair, parser=parser,
        environment=environment, region=region, fields=fields))

    if pages:
        return pd.concat(pages, ignore_index=True)
    return pd.DataFrame()


# ----------------------------------------------------------------------
# 2. recentComments: bulk list-comprehension instead of Series.apply
# ----------------------------------------------------------------------
#
# Same transformation, same `format_recent_comments` function - only the
# call site changes. `.apply()` wraps/unwraps each value through pandas'
# Series machinery; iterating the raw values and assigning the finished
# list back in one shot skips that overhead. Given comments are typically
# just a handful per problem, this plain-Python pass is the right level of
# optimization - fully vectorizing via json_normalize/explode/groupby would
# add real complexity for a hot loop that isn't the bottleneck here.

if "recentComments" in problems.columns:
    problems["recentComments"] = [
        self.format_recent_comments(value) for value in problems["recentComments"]
    ]

def _get_request_result(
    self,
    url,
    headers,
    keypair,
    parser="values",
    environment="prd",
    region="emea",
    fields=None
):
    pages = []
    next_page_url = url

    try:
        while next_page_url:

            response = self.http_requests.request(
                "GET",
                next_page_url,
                headers=headers,
                verify=self.config.get_ca_cert(),
                cert=keypair,
                timeout=300
            )

            # ---------------------------------------------------------
            # Successful response
            # ---------------------------------------------------------
            if response.status_code == 200:

                response_json = response.json()

                if parser is not None:
                    data = response_json[parser]
                else:
                    data = response_json

                page = pd.json_normalize(
                    data,
                    max_level=0
                )

                # Store the page.
                # We concatenate all pages only once at the end.
                pages.append(page)

                # -----------------------------------------------------
                # Pagination
                # -----------------------------------------------------
                next_page_key = response_json.get("nextPageKey")

                if next_page_key:

                    next_page_url = (
                        url.split("?")[0]
                        + "?nextPageKey="
                        + next_page_key
                    )

                    # Problems API requires fields=recentComments
                    # on every paginated request.
                    if fields:
                        next_page_url += f"&fields={fields}"

                else:
                    next_page_url = None

            # ---------------------------------------------------------
            # Unauthorized - refresh token and retry SAME page
            # ---------------------------------------------------------
            elif response.status_code == 401:

                self.tokens.get(environment, {}).pop(region, None)

                headers = {
                    "Accept": "application/json",
                    "Authorization": "Bearer "
                    + self.get_api_token(
                        environment=environment,
                        region=region
                    )
                }

                # Keep next_page_url unchanged.
                # This retries the page that returned 401.
                continue

            # ---------------------------------------------------------
            # Any other HTTP error
            # ---------------------------------------------------------
            else:
                response.raise_for_status()

        # -------------------------------------------------------------
        # Concatenate all pages ONCE
        # -------------------------------------------------------------
        if pages:
            return pd.concat(
                pages,
                ignore_index=True
            )

        return pd.DataFrame()

    except Exception as error:
        logging.warning("Request failed for URL: %s", url)
        logging.debug(error)

        return pd.DataFrame()

def _get_request_result(
    self,
    url,
    headers,
    keypair,
    parser="values",
    environment=None,
    region="emea",
    fields=None,
    page_num=1,                                    # <-- NEW: track which page this call is
):
    try:
        if environment is None:
            environment = os.environ.get("ENVIRONMENT", "dev").lower()
        response = self.http_requests.request(
            "GET", url, headers=headers,
            verify=self.config.get_ca_cert(), cert=keypair, timeout=300,
        )

        if response.status_code == 200:
            if parser is not None:
                data = response.json()[parser]
            else:
                data = response.json()
            page = pd.json_normalize(data, max_level=0)

            # <-- NEW: per-page visibility
            if parser == "problems":
                n_with_comments = 0
                if "recentComments" in page.columns:
                    n_with_comments = page["recentComments"].apply(
                        lambda x: isinstance(x, dict) and bool(x.get("comments"))
                    ).sum()
                logging.warning(
                    "PAGE %s | rows=%s | rows_with_comments=%s | has_recentComments_col=%s",
                    page_num, len(page), n_with_comments, "recentComments" in page.columns,
                )

            if (
                "nextPageKey" in response.json()
                and response.json()["nextPageKey"] is not None
            ):
                next_page_url = url.split("?")[0] + "?nextPageKey=" + response.json()["nextPageKey"]
                if fields:
                    next_page_url += f"&fields={fields}"

                next_page = self._get_request_result(
                    url=next_page_url, headers=headers, keypair=keypair,
                    parser=parser, fields=fields,
                    page_num=page_num + 1,           # <-- NEW: increment for next recursive call
                )
                page = pd.concat([page, next_page], ignore_index=True)

            return page
        ...






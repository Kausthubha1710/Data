if response.status_code == 200:
    if parser is not None:
        data = response.json()[parser]
    else:
        data = response.json()

    if parser == "problems":
        for problem in data:
            if (
                "recentComments" in problem
                and problem["recentComments"].get("totalCount", 0) > 0
            ):
                print("\n===== FOUND A COMMENT =====")
                print("Problem ID:", problem.get("problemId"))
                print(
                    "Recent Comments:",
                    problem.get("recentComments")
                )

    page = pd.json_normalize(data, max_level=0)

    if (
        "nextPageKey" in response.json()
        and response.json()["nextPageKey"] is not None
    ):
        next_page_url = (
            url.split("?")[0]
            + "?nextPageKey="
            + response.json()["nextPageKey"]
        )

        if fields:
            next_page_url += f"&fields={fields}"

        next_page = self._get_request_result(
            url=next_page_url,
            headers=headers,
            keypair=keypair,
            parser=parser,
            environment=environment,
            region=region,
            fields=fields,
        )

        page = pd.concat(
            [page, next_page],
            ignore_index=True
        )

    return page














